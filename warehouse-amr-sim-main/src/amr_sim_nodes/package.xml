<?xml version="1.0"?>
<package format="3">
  <name>amr_sim_nodes</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes for the warehouse AMR simulation: fault_injector, pedestrian_sim, metrics_monitor, data_logger, episode_runner.</description>
  <maintainer email="maintainer@example.com">warehouse-amr-sim team</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>amr_sim_core</exec_depend>
  <exec_depend>amr_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
