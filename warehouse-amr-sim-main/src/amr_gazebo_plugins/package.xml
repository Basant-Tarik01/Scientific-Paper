<?xml version="1.0"?>
<package format="3">
  <name>amr_gazebo_plugins</name>
  <version>0.1.0</version>
  <description>Gazebo Classic plugins for the warehouse AMR simulation (pedestrian pose driver).</description>
  <maintainer email="maintainer@example.com">warehouse-amr-sim team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>rclcpp</depend>
  <depend>amr_interfaces</depend>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="${prefix}/lib"/>
  </export>
</package>
